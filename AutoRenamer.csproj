  <ItemGroup>
    <Reference Include="UAssetAPI">
      <HintPath>..\AutoMog\UAssetAPI\UAssetAPI\bin\Debug\net8.0\UAssetAPI.dll</HintPath>
    </Reference>
  </ItemGroup>

